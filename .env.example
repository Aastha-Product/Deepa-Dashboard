# Copy to .env for local runs. On Vercel, set the same names under Project > Settings > Environment Variables.
# Never commit .env.

# Supabase: use the connection POOLER string (transaction mode) and keep ?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only; never sent to the browser

TZ=Asia/Kolkata

# P6 - Vercel cron sends "Authorization: Bearer <CRON_SECRET>"; /api/run rejects anything else
CRON_SECRET=

# P5 - Claude API (server only)
ANTHROPIC_API_KEY=

# P8 - summary email and IT alert
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO_SUMMARY=        # Raghav, Procurement, Deepa (comma-separated)
MAIL_TO_IT_ALERT=

# P3 - Zoho Inventory, India data centre, read-only scopes (no PO creation)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# P6 - demo only: replay the seed data as the Mon 19 Oct 2026 run
RUN_AS_OF=
